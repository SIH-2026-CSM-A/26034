# Copy to .env beside docker-compose.prod.yml and replace every placeholder.
# .env is git-ignored. Never commit a real value. Nothing here is a working secret.

# --- Database ---------------------------------------------------------------
# The backend reaches the container over the compose network on 5432; DATABASE_URL is
# assembled from these three in docker-compose.prod.yml. The host publishes 5433.
POSTGRES_USER=pccs
POSTGRES_PASSWORD=replace-me-with-a-generated-password
POSTGRES_DB=pccs

# --- Auth -------------------------------------------------------------------
# Signing key for access tokens. Minimum 32 characters; the app refuses to start below
# that and has no default. Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-openssl-rand-hex-32-at-least-32-chars

# Officers who may log in, until there is a users table. Empty list = no accounts, which
# is the shipped state. password_hash is a bcrypt hash, never a password — produce one
# with app.core.auth.hash_password. Fill a jurisdiction to the depth the tier requires.
# OFFICERS=[{"username":"<username>","password_hash":"<bcrypt hash>","tier":"district","jurisdiction":{"state":"<state>","region":"<region>","district":"<district>"}}]
OFFICERS=[]

# --- URLs -------------------------------------------------------------------
# Where the browser reaches the backend. Baked into the frontend bundle at BUILD time —
# `docker compose -f docker-compose.prod.yml build frontend` again after changing it.
#
# Leave this as the relative path `/api`. nginx in the frontend image proxies /api/ to
# the backend over the compose network, so the bundle and the API share one origin and
# the browser makes no cross-origin request at all. **Do not set an absolute URL here.**
# `http://<vm-ip>:8000` is what made this a CORS problem in the first place: it puts the
# API on a second origin and then needs the backend to grant it.
VITE_API_BASE_URL=/api

# Origins allowed to call the API from a browser, comma-separated, no trailing slash.
# With VITE_API_BASE_URL=/api this is NOT on the browser path any more — every call the
# officer surface makes is same-origin and never preflights. The backend still mounts
# CORSMiddleware and still reads this, so it only governs something calling port 8000
# directly from a browser. Leave it at the default unless you have such a caller.

# --- Object storage ---------------------------------------------------------
# MINIO_ROOT_PASSWORD must be at least 8 characters or the container refuses to start.
MINIO_ROOT_USER=pccs
MINIO_ROOT_PASSWORD=replace-me-with-a-generated-password

# --- Application ------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Not set here -----------------------------------------------------------
# OCR_DET_MODEL_DIR, OCR_REC_MODEL_DIR and TESSERACT_TESSDATA_DIR are baked into the
# backend image as ENV during the build and must not be overridden — the paths point at
# weights that exist only inside the image.
#
# PDP_WEIGHTS_PATH is deliberately left unset. There is no PDP-trained detector, and
# pointing it at stock COCO weights is worse than unset: detect_pdp returns a box from
# whatever the detector hands back, and that area feeds the Rule 7 band lookup.
