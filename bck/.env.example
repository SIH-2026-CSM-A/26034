# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Database ---------------------------------------------------------------
# SQLAlchemy URL, also read by Alembic. The `+psycopg` driver suffix is required: bare
# `postgresql://` resolves to psycopg2, which is not installed. One string serves both
# modes — the app opens it with create_async_engine, Alembic with create_engine.
# This default matches the `db` service in ../docker-compose.yml.
DATABASE_URL=postgresql+psycopg://pccs:pccs@localhost:5432/pccs

# --- API --------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Application ------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directory holding local image/label data. See datasets/README.md.
DATASETS_DIR=

# Directory holding the machine-readable rules corpus. See rules-corpus/README.md.
RULES_CORPUS_DIR=

# --- Model weights ----------------------------------------------------------
# All three are required to serve a scan and are checked at startup: the app refuses to
# boot naming whichever is missing, rather than failing on an officer's first request.
# Weights are gitignored and must be pre-cached locally — the demo has to survive the
# venue network failing, so nothing here is downloaded on demand.
# YOLO weights for principal display panel detection.
PDP_WEIGHTS_PATH=
# PaddleOCR text detection model directory.
OCR_DET_MODEL_DIR=
# PaddleOCR text recognition model directory.
OCR_REC_MODEL_DIR=

# --- Auth -------------------------------------------------------------------
# Signing key for access tokens. No default: the app refuses to start without one.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# How long an issued access token stays valid.
ACCESS_TOKEN_TTL_MINUTES=60

# --- RBAC -------------------------------------------------------------------
# The three tiers are structural and fixed. Their designations are not — nomenclature
# varies by state. Keys are the tiers (state, region, district); values are the titles
# this deployment's department actually uses. Omit to use the defaults in
# app/core/config.py. All three tiers must be named if any are.
# ROLE_DESIGNATIONS={"state":"Controller of Legal Metrology","region":"Deputy Controller of Legal Metrology","district":"Legal Metrology Inspector"}

# Officers who may log in, until there is a users table. `password_hash` is a bcrypt
# hash, never a password — produce one with app.core.auth.hash_password. A jurisdiction
# is filled to exactly the depth its tier requires: a state officer names only a state.
# Empty by default, which means no accounts.
# OFFICERS=[{"username":"<username>","password_hash":"<bcrypt hash>","tier":"district","jurisdiction":{"state":"<state>","region":"<region>","district":"<district>"}}]

# --- Cost ceilings ----------------------------------------------------------
# Spending ceiling per paid provider, read by name before any paid call fires. Cloud OCR
# is 0 by default: off is the shipped state and turning it on is a deliberate act.
# COST_CEILINGS={"CLOUD_OCR":"0"}
