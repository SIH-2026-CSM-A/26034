# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Database ---------------------------------------------------------------
# SQLAlchemy URL, also read by Alembic. psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# --- API --------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Application ------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directory holding local image/label data. See datasets/README.md.
DATASETS_DIR=

# Directory holding the machine-readable rules corpus. See rules-corpus/README.md.
RULES_CORPUS_DIR=
