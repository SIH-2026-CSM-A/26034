# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# --- Environments -----------------------------------------------------------
.venv/
venv/
.env
.env.*
!.env.example

# --- Node -------------------------------------------------------------------
node_modules/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Model weights ----------------------------------------------------------
# Weights are pulled, not committed. Record where from in the owning module's README.
*.pt
*.pth
*.onnx
*.pdparams

# --- Datasets ---------------------------------------------------------------
# Raw images are kept in external storage (Shared Drive), not committed.
# Annotation schemas, documentation, evaluation harnesses, and ground-truth metadata are tracked.
datasets/**/*.jpg
datasets/**/*.jpeg
datasets/**/*.png
datasets/**/*.webp
datasets/**/*.bmp
datasets/**/*.tiff
datasets/raw/
datasets/images/

# --- Editors and OS ---------------------------------------------------------
.DS_Store
.idea/
.vscode/
